{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@theme/*": ["src/theme/*"],
      "@games/*": ["src/games/*"],
      "@store/*": ["src/store/*"],
      "@components/*": ["src/components/*"]
    }
  }
}
